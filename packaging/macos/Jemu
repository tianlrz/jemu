#!/bin/sh
# Jemu.app main executable: start or reuse the local service and open the app window.
# Uses the Python 3.10+ already on this Mac; nothing is bundled or downloaded.
APP_CODE="$(cd "$(dirname "$0")/../Resources/app" && pwd)" || exit 1
. "$APP_CODE/jemu_python.sh"
if ! jemu_find_python; then
  answer=$(osascript -e 'button returned of (display dialog "简幕需要 Python 3.10 或更高版本。安装后重新打开简幕即可。" with title "简幕" buttons {"取消", "打开 Python 下载页"} default button 2 with icon caution)' 2>/dev/null)
  [ "$answer" = "打开 Python 下载页" ] && open "https://www.python.org/downloads/macos/"
  exit 1
fi
exec "$JEMU_PYTHON" "$APP_CODE/launch.pyw"
